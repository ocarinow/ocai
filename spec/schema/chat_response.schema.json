{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocai.dev/spec/schema/chat_response.schema.json",
  "title": "ChatResponse",
  "description": "Canonical-IR chat response.",
  "type": "object",
  "required": ["ir_version", "message"],
  "properties": {
    "ir_version": {
      "type": "string",
      "examples": ["0.1"]
    },
    "message": { "$ref": "message.schema.json" },
    "usage": {
      "type": ["object", "null"],
      "description": "Token accounting.",
      "properties": {
        "prompt_tokens": { "type": ["integer", "null"] },
        "completion_tokens": { "type": ["integer", "null"] },
        "total_tokens": { "type": ["integer", "null"] }
      },
      "additionalProperties": true
    },
    "raw": {
      "type": ["object", "null"],
      "description": "Verbatim provider response payload, retained for lossless escape.",
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    }
  },
  "additionalProperties": true
}
