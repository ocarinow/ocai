{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocai.dev/spec/proposals/ordered-items/response.schema.json",
  "title": "Draft item response",
  "$comment": "Design proposal only. Not an active canonical revision or runtime contract.",
  "type": "object",
  "properties": {
    "proposal": {
      "const": "ordered-items-draft-1"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "items.schema.json"
      }
    },
    "extensions": {
      "type": "object"
    },
    "provider_options": {
      "type": "object"
    },
    "finish": {
      "$ref": "https://ocai.dev/spec/schema/finish.schema.json"
    },
    "usage": {
      "$ref": "https://ocai.dev/spec/schema/usage.schema.json"
    },
    "info": {
      "$ref": "https://ocai.dev/spec/schema/chat_response.schema.json#/$defs/responseInfo"
    }
  },
  "required": [
    "proposal",
    "items"
  ]
}
