{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocai.dev/spec/proposals/ordered-items/content.schema.json",
  "title": "Draft content boundary",
  "$comment": "Design proposal only. Not an active canonical revision or runtime contract.",
  "type": "object",
  "required": [
    "type"
  ],
  "allOf": [
    {
      "$ref": "https://ocai.dev/spec/schema/parts.schema.json"
    },
    {
      "properties": {
        "type": {
          "not": {
            "enum": [
              "reasoning",
              "tool_call",
              "tool_result",
              "server_tool_call",
              "server_tool_result"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "text"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "json"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "value": {}
        },
        "required": [
          "value"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "file"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "$ref": "https://ocai.dev/spec/schema/parts.schema.json#/$defs/source"
          },
          "filename": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "source"
        ]
      }
    }
  ]
}
