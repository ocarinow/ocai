# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.so

# uv / venv
.venv/
uv.lock.bak

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.import_linter_cache/
.coverage
htmlcov/

# Docs site build output and page cache (zensical build)
/site/
/.cache/

# Node (future typescript/)
node_modules/
*.tsbuildinfo

# Go (future go/)
/go/bin/

# Editors / OS. Shared editor settings ARE committed: the multi-root workspace
# (ocai.code-workspace) and each folder's .vscode/settings.json + extensions.json
# give Pylance/Ruff the right interpreter per project. Personal files stay local.
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.DS_Store

# Per-user agent settings (never commit personal permissions)
.claude/settings.local.json
.codex/config.toml

# Platform build and browser-test artifacts
.nuxt/
.output/
platform/test-results/
platform/playwright-report/

# Local environment files: the root .env is the active one, .envs/ holds the
# per-environment variants (`task env -- <ENV>` copies .envs/.env.<ENV> to .env).
# Never committed: they hold credentials.
/.env
/.envs/
.local/

# Task execution fingerprints
.task/
