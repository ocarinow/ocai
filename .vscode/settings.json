{
  // Root folder of the multi-root workspace (ocai.code-workspace): the uv
  // workspace for the kernel and the provider plugins. Its interpreter is the
  // root .venv; the other Python projects are their own workspace folders and
  // are excluded here so Pylance never resolves them against this venv.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.analysis.exclude": [
    "platform/**",
    "examples/ocai-contrib-echo/**",
    "**/.venv/**",
    "**/node_modules/**",
    "site/**"
  ],
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": [
    "python/packages/ocai-core/tests",
    "python/packages/ocai-openai/tests",
    "python/packages/ocai-anthropic/tests"
  ],
  "ruff.configuration": "${workspaceFolder}/pyproject.toml"
}
