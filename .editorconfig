# Editor defaults shared by every tool (https://editorconfig.org). Formatting
# itself is enforced by ruff (Python) and the Nuxt toolchain (TypeScript/Vue);
# this file only keeps whitespace consistent in files no formatter owns.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.{md,markdown}]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{sql,toml,yml,yaml,json,ts,vue,js,mjs,css}]
indent_size = 2
