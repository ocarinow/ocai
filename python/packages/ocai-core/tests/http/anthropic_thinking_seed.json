{
  "description": "WU-42 synthetic first-turn Messages recording for thinking replay. Paired with anthropic_thinking_replay.json; signature is an inert test token. Wire shape follows docs/providers/anthropic.md thinking/signature contracts.",
  "request": {
    "method": "POST",
    "url": "https://api.anthropic.com/v1/messages",
    "json": {
      "model": "claude-opus-4-6",
      "max_tokens": 1024,
      "messages": [
        {
          "role": "user",
          "content": [
            {
              "type": "text",
              "text": "First question"
            }
          ]
        }
      ],
      "thinking": {
        "type": "adaptive"
      }
    }
  },
  "response": {
    "status": 200,
    "json": {
      "id": "msg-replay-test",
      "type": "message",
      "role": "assistant",
      "model": "claude-opus-4-6",
      "content": [
        {
          "type": "thinking",
          "thinking": "Reasoned answer",
          "signature": "sig-test+/=="
        },
        {
          "type": "text",
          "text": "Answer"
        }
      ],
      "stop_reason": "end_turn",
      "usage": {
        "input_tokens": 14,
        "output_tokens": 9
      }
    }
  }
}
